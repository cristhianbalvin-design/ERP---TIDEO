    "manual:extraer": "node scripts/manual/extraer.mjs",
    "verificar:catalogo": "node scripts/manual/catalogo.mjs verificar && node scripts/verificar-manual-pantallas.mjs && node scripts/manual/completitud.mjs --verificar",
