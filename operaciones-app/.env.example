# Credenciales propias del despliegue operativo. Deben apuntar al mismo proyecto backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Ruta de montaje cuando ambas aplicaciones se sirven bajo el mismo dominio.
VITE_APP_BASE_PATH=/operaciones/
# URL de la app administrativa en el mismo dominio, si se desea enlazarla.
VITE_ADMIN_APP_URL=/
